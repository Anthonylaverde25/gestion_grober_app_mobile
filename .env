# =========================================================================
# GESTIÓN GROBER - CONFIGURACIÓN DE ENTORNOS (API URL)
# Para alternar de entorno, descomenta la línea deseada (quitando el #)
# y comenta las demás (agregando un # al inicio).
# =========================================================================

# ── [ENTORNO] PRODUCCIÓN (Railway Cloud)
EXPO_PUBLIC_API_URL=https://gestiongroberapi-production.up.railway.app/api

# ── [ENTORNO] DESARROLLO - SIMULADOR iOS (Localhost Mac)
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# ── [ENTORNO] DESARROLLO - EMULADOR ANDROID
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# ── [ENTORNO] DESARROLLO - DISPOSITIVO FÍSICO (Expo Go / Wi-Fi)
# (Reemplaza la IP con la IP local de tu Mac en tu red de Wi-Fi, ej: 192.168.1.15)
# EXPO_PUBLIC_API_URL=http://192.168.1.XX:8000/api
